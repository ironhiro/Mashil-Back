<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Swagger 가 IncludeXmlComments 로 endpoint/모델 설명을 끌어올 XML 문서 산출. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- 모든 public 멤버에 doc 주석 강제하지 않기 (1591) — 의미 있는 곳만 적는다. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- dotnet user-secrets set "Kakao:RestApiKey" "..." 등으로 dev secret 주입. -->
    <UserSecretsId>mashil-api-3f7e82a4-e2c8-4f6e-9d1a-1b9c54a6f8a2</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mashil.Domain\Mashil.Domain.csproj" />
    <ProjectReference Include="..\Mashil.Infrastructure\Mashil.Infrastructure.csproj" />
    <ProjectReference Include="..\Mashil.Import\Mashil.Import.csproj" />
    <!-- YhLibrary 의존 제거 (2026-11-14): Kakao 클라이언트가 Mashil.Import 의 KakaoAddressGeocoder 로 옮겨감. -->
    <!-- 저장소만으로 빌드되므로 Docker 빌드 컨텍스트가 단순해지고 MessagePack 취약점 경고도 사라짐. -->
    <!-- 다시 필요하면 $(YhLibraryRoot) 참조를 되살리면 된다 (Directory.Build.props 정의는 남겨 둠). -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- 디자인 타임 전용 (dotnet ef). 런타임 출력에 포함되지 않음. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Sentry.AspNetCore" />
    <PackageReference Include="Sentry.Serilog" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

</Project>
