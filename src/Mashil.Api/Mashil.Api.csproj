<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Swagger 가 IncludeXmlComments 로 endpoint/모델 설명을 끌어올 XML 문서 산출. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- 모든 public 멤버에 doc 주석 강제하지 않기 (1591) — 의미 있는 곳만 적는다. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- dotnet user-secrets set "Kakao:RestApiKey" "..." 등으로 dev secret 주입. -->
    <UserSecretsId>mashil-api-3f7e82a4-e2c8-4f6e-9d1a-1b9c54a6f8a2</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mashil.Domain\Mashil.Domain.csproj" />
    <ProjectReference Include="..\Mashil.Infrastructure\Mashil.Infrastructure.csproj" />
    <!-- YhLibraryRoot 는 Directory.Build.props 에서 정의 (기본 ../MyLibrary, env YHLIBRARY_ROOT 로 override). -->
    <ProjectReference Include="$(YhLibraryRoot)\src\YhLibrary.Http\YhLibrary.Http.csproj" />
    <ProjectReference Include="$(YhLibraryRoot)\src\YhLibrary.Serialization\YhLibrary.Serialization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

</Project>
