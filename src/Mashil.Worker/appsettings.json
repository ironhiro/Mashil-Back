{
  "_comment": "민감한 값(RestApiKey, DB 패스워드, 웹훅 URL)은 User Secrets 또는 환경 변수로. Mashil.Api 와 같은 User Secrets 를 공유한다.",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=mashil;Username=mashil;Password=mashil_dev"
  },
  "Import": {
    "Schedule": {
      "Enabled": true,
      "TimeKst": "04:30",
      "RunOnStartup": false,
      "SourceCode": "LOCALDATA_PUBLIC_RESTROOM"
    },
    "Policy": {
      "MaxSizeChangeRatio": 0.30,
      "MaxRowDropRatio": 0.05,
      "MaxSkippedRatio": 0.01,
      "RemoveAfterMisses": 3,
      "MaxRemovalRatio": 0.01
    },
    "LocalData": {
      "_comment": "정보 페이지는 공공데이터포털 표준데이터 페이지에서 넘어와야 열린다 → EntryReferer. 브라우저 헤더는 불필요 (2026-11-14 확인).",
      "UserAgent": "MashilDataSync/1.0",
      "EntryReferer": "https://www.data.go.kr/data/15012892/standard.do",
      "BrowserHeaders": false
    }
  },
  "Alerts": {
    "_comment": "Slack/Discord 웹훅 URL. 비우면 로그로만 알림. dotnet user-secrets --project src/Mashil.Worker set \"Alerts:WebhookUrl\" \"https://...\"",
    "WebhookUrl": ""
  },
  "Kakao": {
    "RestApiKey": ""
  },
  "Geocode": {
    "_comment": "Kakao:RestApiKey 가 비어있으면 idle.",
    "Enabled": true,
    "BatchSize": 50,
    "RequestDelayMs": 200,
    "BatchSleepSeconds": 10,
    "IdleSleepSeconds": 300
  },
  "Sentry": {
    "_comment": "Dsn 이 비어 있으면 Sentry 를 켜지 않는다. 운영은 환경 변수 Sentry__Dsn (API 와 같은 프로젝트를 써도 된다).",
    "Dsn": ""
  },
  "Serilog": {
    "_comment": "API 와 같은 규칙. 운영(Production)은 콘솔 JSON, 개발은 텍스트.",
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  }
}
