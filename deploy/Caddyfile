# 마실 운영 진입점 (자동 TLS). 한 도메인에서
#   /api/*, /healthz*  → api-blue / api-green (헬스체크 기반, 무중단 교체)
#   그 외               → 웹 SPA 정적 파일 (/srv/web = 호스트 ${MASHIL_WEB_ROOT}/site, deploy/web-deploy.sh 가 채움)
# 웹은 /api 를 상대 경로로 부르므로 같은 도메인에 둔다 (CORS 불필요). 나중에 CDN 을 두면 이 도메인 전체를 origin 으로.
# 앞단에 로드밸런서·CDN 을 두게 되면 전역 옵션 servers { trusted_proxies static <대역> } 을 추가한다.
# 지금은 클라이언트가 직접 붙으므로 Caddy 는 들어온 X-Forwarded-For 를 버리고 실제 접속 IP 를 API 로 넘긴다
# (API 빈도 제한이 이 값을 씀 — ForwardedHeaders:KnownNetworks 로 Caddy 만 믿게 했다).

{$MASHIL_DOMAIN} {
	encode zstd gzip

	# 보안 헤더 (NFR-05). HSTS 는 1년 — 하위 도메인은 따로 정하지 않았으므로 includeSubDomains 는 넣지 않음
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "camera=(), microphone=(), payment=(), usb=(), geolocation=(self)"
		-Server
	}

	# 위치 쿼리(lat/lng)는 접근 로그에 남기지 않는다 (NFR-06)
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					delete lat
					delete lng
					delete north
					delete south
					delete east
					delete west
				}
				request>headers>Authorization delete
				request>headers>Cookie delete
				request>remote_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>client_ip ip_mask {
					ipv4 24
					ipv6 48
				}
			}
		}
	}

	handle /api/* {
		reverse_proxy api-blue:8080 api-green:8080 {
			lb_policy round_robin
			lb_try_duration 10s          # 한쪽 교체 중이면 다른 쪽으로 재시도
			health_uri /healthz/ready
			health_interval 5s
			health_timeout 3s
		}
	}

	handle /healthz* {
		reverse_proxy api-blue:8080 api-green:8080 {
			health_uri /healthz/ready
		}
	}

	# 빌드 해시가 붙은 에셋 — 바뀌지 않으므로 1년 캐시. 없는 파일은 index.html 로 넘기지 않고 404
	handle /assets/* {
		root * /srv/web
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# 나머지 — index.html 과 public/ 파일은 매번 재검증 (no-cache: ETag 로 304). SPA 라우트는 index.html 로
	handle {
		root * /srv/web
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	# API 가 두 쪽 다 내려가 있으면 점검 상태는 정적 파일로 답한다 (OPS-05 정적 폴백, /srv/status/status.json)
	handle_errors {
		@statusFallback {
			path /api/app/status
			expression `{err.status_code} >= 502`
		}
		handle @statusFallback {
			root * /srv/status
			rewrite * /status.json
			header Cache-Control "no-store"
			file_server
		}
		handle {
			respond "{err.status_code} {err.status_text}"
		}
	}
}
