# 운영 환경 변수 템플릿. /etc/mashil/mashil.env 로 복사해서 값을 채우고 chmod 600.
# 이 파일(.env.example)에는 실제 값을 넣지 않는다.

MASHIL_DOMAIN=api.example.com
POSTGRES_PASSWORD=change-me

# 이미지: deploy.sh <tag> 는 ${MASHIL_REGISTRY}/mashil-{api,worker,migrate}:<tag> 를 쓴다 (OWNER 는 소문자).
# 태그 없이 deploy.sh 를 돌리면 아래 MASHIL_IMAGE_* 를 그대로 쓴다.
MASHIL_REGISTRY=ghcr.io/OWNER
MASHIL_IMAGE_API=ghcr.io/OWNER/mashil-api:latest
MASHIL_IMAGE_WORKER=ghcr.io/OWNER/mashil-worker:latest
MASHIL_IMAGE_MIGRATE=ghcr.io/OWNER/mashil-migrate:latest

# 호스트 경로 (기본값이면 생략 가능)
MASHIL_WEB_ROOT=/srv/mashil/web
MASHIL_STATUS_DIR=/srv/mashil/status
# 내부 docker 네트워크 대역 — API 가 X-Forwarded-For 를 믿는 범위와 같다. 서버의 다른 대역과 겹치면 바꾼다
MASHIL_DOCKER_SUBNET=172.30.0.0/24

# 백업 (deploy/backup.sh). REMOTE 는 rclone 원격 이름:경로 — 비우면 서버 안에만 보관
MASHIL_BACKUP_DIR=/var/backups/mashil
MASHIL_BACKUP_DAILY_DAYS=7
MASHIL_BACKUP_WEEKLY_DAYS=28
MASHIL_BACKUP_REMOTE=
MASHIL_DISK_ALERT_PERCENT=80

# 에러 모니터링 (API + Worker 공통). 비우면 꺼짐. 개인정보는 보내지 않는다 (SendDefaultPii=false, 위치 쿼리 마스킹)
Sentry__Dsn=
Sentry__Environment=production
# 성능 추적 비율 (0 = 끔). 켜면 요청 URL 의 위치 쿼리도 같이 마스킹된다
# Sentry__TracesSampleRate=0.05

# 빈도 제한 — 기본값은 src/Mashil.Api/appsettings.json (IP 당 분당 Global 1200 / Write 60 / Auth 30)
# RateLimiting__Auth__PermitLimit=30
# RateLimiting__Enabled=false

# API
Jwt__SigningKey=
Cors__Origins=https://www.example.com

# OAuth (API + Worker 공통 — Worker 는 탈퇴 연결 해제 재시도에 씀). docs/AUTH.md 참고
# 배열은 __0, __1 ... 로 이어 붙인다. 값이 빈 제공자는 꺼진다.
OAuth__Kakao__AppId=
OAuth__Kakao__Audiences__0=
OAuth__Kakao__Audiences__1=
OAuth__Kakao__AdminKey=
OAuth__Kakao__RedirectUris__0=
OAuth__Google__ClientIds__0=
OAuth__Apple__ClientIds__0=
OAuth__Apple__TeamId=
OAuth__Apple__KeyId=
OAuth__Apple__PrivateKey=
# openssl rand -base64 32 — 바꾸면 저장된 Apple 토큰을 읽을 수 없게 된다
OAuth__TokenEncryptionKey=
# 약관 버전 (올리면 다음 로그인 때 재동의)
Consents__Documents__0__Type=Terms
Consents__Documents__0__Version=1
Consents__Documents__1__Type=Privacy
Consents__Documents__1__Version=1
Consents__Documents__2__Type=LocationTerms
Consents__Documents__2__Version=1

# Worker (Alerts__WebhookUrl 은 deploy/*.sh 의 배포·백업 실패, 디스크 경고에도 쓴다)
Kakao__RestApiKey=
Alerts__WebhookUrl=
Geocode__Enabled=true
Import__Schedule__Enabled=true
